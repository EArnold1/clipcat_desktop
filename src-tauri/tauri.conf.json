{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipcat-app",
  "version": "0.1.0",
  "identifier": "com.arnold.clipcat-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clipcat",
        "width": 395,
        "minHeight": 470,
        "minWidth": 330,
        "height": 550,
        "maxWidth": 400,
        "maxHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.ico", "icons/icon.png"]
  }
}
